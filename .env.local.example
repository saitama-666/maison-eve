# ------------------------------------------------------------------
# MAISON EVE — variables d'environnement
# Copie ce fichier en `.env.local` et remplis les valeurs.
# `.env.local` ne doit JAMAIS être commité.
# ------------------------------------------------------------------

# --- Firebase côté client ---
# Console Firebase > Paramètres du projet > Vos applications > Web.
# Ces clés sont PUBLIQUES par nature : elles identifient le projet, elles
# ne l'autorisent pas. La sécurité réelle vient de `firestore.rules`, de la
# restriction de la clé API par référent HTTP, et d'App Check.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=maison-eve.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=maison-eve
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=maison-eve.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- App Check (reCAPTCHA v3, recommandé en production) ---
# Laisse vide en développement.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Mets à "1" pour brancher l'app sur les émulateurs Firebase locaux.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=

# --- Firebase Admin (SERVEUR uniquement — jamais de préfixe NEXT_PUBLIC_) ---
# Console Firebase > Paramètres du projet > Comptes de service > Générer une clé privée.
# Colle le JSON complet sur une seule ligne, entre guillemets simples.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Alternative au JSON complet (Vercel, etc.) :
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
