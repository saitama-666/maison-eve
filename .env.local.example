# ------------------------------------------------------------------
# MAISON EVE — variables d'environnement
# Copie ce fichier en `.env.local` et remplis les valeurs.
# `.env.local` ne doit JAMAIS être commité.
# ------------------------------------------------------------------

# --- Firebase côté client ---
# Console Firebase > Paramètres du projet > Vos applications > Web.
# Ces clés sont PUBLIQUES par nature : elles identifient le projet, elles
# ne l'autorisent pas. La sécurité réelle vient de `firestore.rules`, de la
# restriction de la clé API par référent HTTP, et d'App Check.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=maison-eve-beauty-and-spa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=maison-eve-beauty-and-spa
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=maison-eve-beauty-and-spa.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- App Check ---
#
# ⚠️  CETTE VARIABLE N'EST LUE NULLE PART AUJOURD'HUI.
#     App Check n'est pas branché dans le code : la remplir ne protège
#     rien. Gardée pour mémoire, à traiter avant la mise en ligne.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Mets à "1" pour brancher l'app sur les émulateurs Firebase locaux.
# (Ils nécessitent Java.)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=

# ------------------------------------------------------------------
#  Firebase Admin — SERVEUR uniquement.
#
#  Deux formes acceptées. En local, PRÉFÈRE LA PREMIÈRE.
# ------------------------------------------------------------------

# --- Forme 1 (recommandée en local) : un CHEMIN vers le fichier ---
#
# Console Firebase > Paramètres du projet > Comptes de service >
# « Générer une nouvelle clé privée ». Place le .json téléchargé à la
# racine du projet sous le nom `service-account.json` — il est déjà
# couvert par `.gitignore`.
#
# Pourquoi un chemin plutôt que la clé : un fichier de configuration finit
# toujours par être ouvert devant quelqu'un, collé dans un ticket, ou
# affiché par un outil. C'est exactement comme ça qu'une clé de ce projet
# a fuité une fois. Un chemin ne coûte rien s'il fuite ; une clé privée
# coûte tout — elle contourne TOUTES les règles de sécurité Firestore.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# --- Forme 2 : le JSON complet sur une seule ligne ---
#
# Nécessaire chez un hébergeur sans système de fichiers persistant
# (Vercel, Netlify…). Là-bas, déclare-la comme variable SENSIBLE pour
# qu'elle reste masquée dans l'interface.
#
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'

# --- Forme 3 : les trois champs séparés ---
#
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
